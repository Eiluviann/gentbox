{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"allowImportingTsExtensions": false,
		"rewriteRelativeImportExtensions": true,
		"outDir": "dist",
		"rootDir": "src",
		"module": "NodeNext",
		"moduleResolution": "NodeNext"
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/test-support"]
}
