<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
A build signed ad hoc (Sign to Run Locally), with no provisioning profile and
no team: no App Group, so the state goes to ~/Library/Application
Support/Gentbox, which the CLI also searches (architecture §3, §8). A subset of
Full.entitlements. See docs/signing.md.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/Library/Application Support/Gentbox/</string>
	</array>
</dict>
</plist>
